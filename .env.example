# Aloqa formasi xabarni Telegramga yuboradi.
# Bot @BotFather orqali yaratiladi; chat_id ni olish uchun botga (yoki
# guruhga) bir marta /start yozib, keyin: npm run tg:id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Musiqa pleylistini sinxronlash uchun — ixtiyoriy.
# npm run music:sync kalitlarsiz ham ishlaydi (oEmbed orqali, bitta muqova).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
